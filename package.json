{
  "name": "smartdj-frontend",
  "private": true,
  "description": "Sitio estático de Smart DJ. Este package.json es solo para pruebas, lint y formato: el sitio no tiene build.",
  "scripts": {
    "test": "node --test \"scripts/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "node --test --experimental-test-coverage \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "prettier": "3.4.2"
  }
}
